# Copy these into Netlify → Site configuration → Environment variables (scope: Functions).
# Never commit real values: this repo is public.

# Either form works. Use the legacy (non-SRV) form if your host can't resolve mongodb+srv DNS records.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.gdngpgy.mongodb.net/
# MONGODB_URI=mongodb://<user>:<password>@ac-mooymah-shard-00-00.gdngpgy.mongodb.net:27017,ac-mooymah-shard-00-01.gdngpgy.mongodb.net:27017,ac-mooymah-shard-00-02.gdngpgy.mongodb.net:27017/?ssl=true&replicaSet=atlas-118h26-shard-0&authSource=admin

# Password for viewing leads at /api/leads (any username).
LEADS_PASSWORD=choose-a-strong-password

# Optional, defaults to "shantiban".
# MONGODB_DB=shantiban
